# Copy this file to .env and fill in your real eBay Developer Program credentials.
# .env is gitignored and must never be committed or pasted into chat (see PROJECT.md D-02).

EBAY_CLIENT_ID=your-ebay-client-id-here
EBAY_CLIENT_SECRET=your-ebay-client-secret-here

# EBAY_ENV accepts: production or sandbox
EBAY_ENV=production
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/pokemonview

# Ingestion worker: hours between scheduled runs (optional; default 4)
INGESTION_INTERVAL_HOURS=4

# Discord webhook URL for the ingestion staleness alert (optional; when unset,
# check_and_alert_staleness() no-ops instead of raising). Fires a best-effort
# POST when the last successful/partial ingestion run is stale beyond
# STALENESS_THRESHOLD_HOURS (~2x INGESTION_INTERVAL_HOURS, ~8h default).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
